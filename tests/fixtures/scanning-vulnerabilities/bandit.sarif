        {
          "message": {
            "text": "Possible SQL injection vector through string-based query construction."
          },
          "locations": [
            {
              "physicalLocation": {
                "region": {
                  "snippet": {
                    "text": "    rows = db.execute(\"SELECT * FROM users WHERE name = '\" + name + \"'\").fetchall()\n"
