                  "endColumn": 59,
                  "endLine": 17,
                  "startColumn": 23,
                  "startLine": 17
                },
                "artifactLocation": {
                  "uri": "app.py"
                },
                "contextRegion": {
                  "snippet": {
                    "text": "    db = sqlite3.connect(\"app.db\")\n    rows = db.execute(\"SELECT * FROM users WHERE name = '\" + name + \"'\").fetchall()\n    return str(rows)\n"
                  },
                  "endLine": 18,
                  "startLine": 16
                }
              }
            }
          ],
          "properties": {
